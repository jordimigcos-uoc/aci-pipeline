<!DOCTYPE html>
<html lang="ca">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description"
        content="Informe d'accessibilitat ACI per {{ domain }} — Perfil {{ profile_label }}. Puntuació: {{ score_overall }}/100.">
  <meta property="og:title"    content="{{ domain }} · {{ profile_label }} — ACI">
  <meta property="og:description" content="ACI={{ score_overall }}/100 · {{ web_type }}">
  <title>{{ domain }} · {{ profile_label }} — ACI Pipeline</title>
  <link rel="stylesheet" href="../static/css/site.css">
  <link rel="stylesheet" href="../static/css/reports.css">
</head>
<body>
{% set root_path = '../' %}
{% set active_nav = 'report' %}
{% include "header.html.j2" %}

<main id="main" class="page-main">

  {# ── Breadcrumbs ─────────────────────────────────────────────────────── #}
  <nav class="breadcrumbs" aria-label="Fil d'Ariadna">
    <a href="../index.html">Tauler</a>
    <span class="breadcrumbs__sep" aria-hidden="true">›</span>
    <a href="{{ slug }}_comparative.html">{{ domain }}</a>
    <span class="breadcrumbs__sep" aria-hidden="true">›</span>
    <span aria-current="page">{{ profile_label }}</span>
  </nav>

  {# ── Profile nav chips ──────────────────────────────────────────────── #}
  <nav class="profile-nav" aria-label="Navegació entre perfils">
    {% for p in profiles_list %}
    <a href="{{ slug }}_{{ p }}.html"
       class="chip{% if p == profile %} chip--active{% endif %}"
       {% if p == profile %}aria-current="page"{% endif %}>
      {{ profile_labels[p] }}
    </a>
    {% endfor %}
    <a href="{{ slug }}_comparative.html" class="chip chip--cmp">⇄ Comparatiu</a>
  </nav>

  {# ── ACI hero ───────────────────────────────────────────────────────── #}
  {% set sc = score_overall | aci_color %}
  {% set sl = score_overall | aci_label %}
  <div class="aci-hero">
    <div class="aci-score-box">
      <span class="aci-score-value" style="color:{{ sc }}">{{ "%.1f"|format(score_overall) }}</span>
      <span class="aci-score-label" style="color:{{ sc }}">{{ sl }}</span>
      <span style="font-size:0.72rem;color:var(--color-text-muted);margin-top:0.25rem">de 100</span>
    </div>
    <div class="aci-hero-meta">
      <h1>{{ domain }}</h1>
      <p>
        <strong>Perfil:</strong> {{ profile_label }} &nbsp;·&nbsp;
        <strong>Tipus:</strong> {{ web_type|capitalize }} &nbsp;·&nbsp;
        <strong>Anàlisi:</strong> {{ timestamp[:10] if timestamp else 'N/D' }}
      </p>
      <p style="word-break:break-all">
        <a href="{{ url }}" target="_blank" rel="noopener noreferrer"
           style="color:var(--color-accent);font-size:0.85rem">{{ url }}</a>
      </p>
      {% if notes %}
      <p style="margin-top:0.5rem;font-style:italic;font-size:0.88rem;
                color:var(--color-text-muted)">"{{ notes }}"</p>
      {% endif %}
    </div>
    <div style="text-align:right;min-width:100px">
      <div style="font-size:0.75rem;color:var(--color-text-muted);margin-bottom:0.3rem">Pitjor perfil</div>
      <div style="font-size:1.1rem;font-weight:700;color:{{ comparative.worst_score | aci_color }}">
        {{ comparative.worst_score }}
      </div>
      <div style="font-size:0.72rem;color:var(--color-text-muted)">{{ comparative.worst_profile | replace('_',' ') }}</div>
      <div style="font-size:0.75rem;color:var(--color-text-muted);margin:0.6rem 0 0.3rem">Millor perfil</div>
      <div style="font-size:1.1rem;font-weight:700;color:{{ comparative.best_score | aci_color }}">
        {{ comparative.best_score }}
      </div>
      <div style="font-size:0.72rem;color:var(--color-text-muted)">{{ comparative.best_profile | replace('_',' ') }}</div>
    </div>
  </div>

  {# ── Sub-scores ─────────────────────────────────────────────────────── #}
  {% set sub_labels = {
    "wcag":        "WCAG",
    "text":        "Text",
    "elements":    "Elements",
    "performance": "Rendiment"
  } %}
  <div class="sub-scores">
    {% for key in ["wcag", "text", "elements", "performance"] %}
    {% set val = sub_scores_100.get(key, 0) %}
    {% set c   = val | aci_color %}
    <div class="sub-score-card">
      <div class="sub-score-card__label">{{ sub_labels[key] }}</div>
      <div class="sub-score-card__value" style="color:{{ c }}">{{ "%.1f"|format(val) }}</div>
      <div class="sub-score-card__bar-bg">
        <div class="sub-score-card__bar-fill"
             style="width:{{ val }}%;background:{{ c }};transition:width 0.6s ease"></div>
      </div>
    </div>
    {% endfor %}
  </div>

  {# ── Charts ─────────────────────────────────────────────────────────── #}
  <h2 class="section-title">Visualitzacions</h2>
  <div class="charts-grid-2">

    {# Radar WCAG principles #}
    <div class="chart-section">
      <div class="chart-section__header">
        <span class="chart-section__title">Principis WCAG 2.1</span>
        <button class="export-btn"
                onclick="exportChartPNG('radar-canvas','{{ slug }}_{{ profile }}_radar')"
                aria-label="Exporta el gràfic radar com a PNG">⬇ PNG</button>
      </div>
      <div class="chart-container" style="height:280px;display:flex;align-items:center;justify-content:center">
        <canvas id="radar-canvas"
                role="img"
                aria-label="Gràfic radar dels 4 principis WCAG: Perceptible {{ wcag_principles.perceptible }}, Operable {{ wcag_principles.operable }}, Comprensible {{ wcag_principles.comprensible }}, Robust {{ wcag_principles.robust }}">
        </canvas>
      </div>
      {# WCAG principles numerical fallback #}
      <table style="width:100%;font-size:0.78rem;margin-top:0.6rem;border-collapse:collapse"
             aria-label="Valors dels principis WCAG">
        {% for pk, plabel in [("perceptible","Perceptible"),("operable","Operable"),
                               ("comprensible","Comprensible"),("robust","Robust")] %}
        {% set pv = wcag_principles.get(pk, 0) %}
        <tr>
          <td style="padding:0.15rem 0.5rem;color:var(--color-text-muted)">{{ plabel }}</td>
          <td style="padding:0.15rem 0.5rem">
            <div class="metric-bar-wrap">
              <div class="metric-bar-bg">
                <div class="metric-bar-fill"
                     style="width:{{ pv }}%;background:{{ pv | aci_color }}"></div>
              </div>
              <span class="metric-val" style="color:{{ pv | aci_color }}">{{ "%.1f"|format(pv) }}</span>
            </div>
          </td>
        </tr>
        {% endfor %}
      </table>
    </div>

    {# Bar chart 16 metrics #}
    <div class="chart-section">
      <div class="chart-section__header">
        <span class="chart-section__title">Mètriques individuals (0–100)</span>
        <button class="export-btn"
                onclick="exportChartPNG('bar-canvas','{{ slug }}_{{ profile }}_bar')"
                aria-label="Exporta el gràfic de barres com a PNG">⬇ PNG</button>
      </div>
      <div class="chart-container chart-container--tall" style="height:320px">
        <canvas id="bar-canvas"
                role="img"
                aria-label="Gràfic de barres de les 16 mètriques d'accessibilitat del perfil {{ profile_label }}">
        </canvas>
      </div>
    </div>

  </div>{# end charts-grid-2 #}

  {# ── Metrics table ──────────────────────────────────────────────────── #}
  <h2 class="section-title">Detall de mètriques</h2>

  {% set metric_groups = [
    {
      "key":   "wcag",
      "label": "WCAG — Accessibilitat tècnica (8 mètriques)",
      "items": [
        {"long": "color_contrast_ratio",     "short": "color_contrast",      "wcag_ref": "1.4.3 AA"},
        {"long": "focus_visible_ratio",      "short": "focus_visibility",    "wcag_ref": "2.4.7 AA"},
        {"long": "target_size_clean",        "short": "target_size",         "wcag_ref": "2.5.8 AA"},
        {"long": "keyboard_clean",           "short": "keyboard_nav",        "wcag_ref": "2.1.1 A"},
        {"long": "aria_roles_valid",         "short": "aria_roles",          "wcag_ref": "4.1.2 AA"},
        {"long": "accessible_names_coverage","short": "accessible_names",    "wcag_ref": "4.1.2 AA"},
        {"long": "audit_critical_violations","short": "critical_violations", "wcag_ref": "Múltiples"},
        {"long": "audit_high_violations",    "short": "high_violations",     "wcag_ref": "Múltiples"}
      ]
    },
    {
      "key":   "text",
      "label": "Text — Llegibilitat (3 mètriques)",
      "items": [
        {"long": "page_flesch",      "short": "flesch_reading_ease", "wcag_ref": "3.1.5 AAA"},
        {"long": "text_complexity",  "short": "text_complexity",     "wcag_ref": "3.1 AA"},
        {"long": "heading_hierarchy","short": "heading_hierarchy",   "wcag_ref": "1.3.1 A"}
      ]
    },
    {
      "key":   "elements",
      "label": "Elements — Estructura (4 mètriques)",
      "items": [
        {"long": "alt_text_coverage",       "short": "alt_text_coverage", "wcag_ref": "1.1.1 A"},
        {"long": "landmark_coverage",       "short": "landmark_coverage", "wcag_ref": "1.3.6 AAA"},
        {"long": "audit_medium_violations", "short": "medium_violations", "wcag_ref": "Múltiples"},
        {"long": "audit_low_violations",    "short": "low_violations",    "wcag_ref": "Múltiples"}
      ]
    },
    {
      "key":   "performance",
      "label": "Rendiment (1 mètrica)",
      "items": [
        {"long": "performance_lcp", "short": "performance_lcp", "wcag_ref": "EN 301 549"}
      ]
    }
  ] %}

  <div class="metrics-table-wrapper">
    <table class="metrics-table"
           aria-label="Detall de les 16 mètriques d'accessibilitat per al perfil {{ profile_label }}">
      <thead>
        <tr>
          <th scope="col">Mètrica</th>
          <th scope="col" style="min-width:200px">Puntuació (0–100)</th>
          <th scope="col">Ref. WCAG</th>
        </tr>
      </thead>
      <tbody>
        {% for group in metric_groups %}
        <tr class="group-header">
          <td colspan="3">{{ group.label }}</td>
        </tr>
        {% for m in group.items %}
        {% set val = metrics.get(m.short, 0) %}
        {% set mc  = val | aci_color %}
        <tr>
          <td>{{ metric_labels.get(m.long, m.long) }}</td>
          <td>
            <div class="metric-bar-wrap">
              <div class="metric-bar-bg">
                <div class="metric-bar-fill"
                     style="width:{{ val }}%;background:{{ mc }}"></div>
              </div>
              <span class="metric-val" style="color:{{ mc }}">{{ "%.1f"|format(val) }}</span>
            </div>
          </td>
          <td><span class="wcag-badge">{{ m.wcag_ref }}</span></td>
        </tr>
        {% endfor %}
        {% endfor %}
      </tbody>
    </table>
  </div>

  {# ── Notes ──────────────────────────────────────────────────────────── #}
  {% if notes %}
  <h2 class="section-title">Notes interpretatives</h2>
  <div class="notes-box">
    <strong>Nota del perfil {{ profile_label }}:</strong> {{ notes }}
  </div>
  {% endif %}

  {# ── Comparison mini-summary ────────────────────────────────────────── #}
  {% if profiles_data | length > 1 %}
  <h2 class="section-title">Resum comparatiu entre perfils</h2>
  <div class="cmp-summary-grid">
    {% for p in profiles_list %}
    {% if p in profiles_data %}
    {% set pd = profiles_data[p] %}
    {% set pc = pd.score_overall | aci_color %}
    <div class="cmp-card"
         {% if p == profile %}style="border:2px solid {{ profile_color }};background:#f0f4ff"{% endif %}>
      <div class="cmp-card__label">{{ profile_labels[p] }}</div>
      <div class="cmp-card__score" style="color:{{ pc }}">{{ "%.1f"|format(pd.score_overall) }}</div>
      <div class="cmp-card__profile">{{ pd.score_overall | aci_label }}</div>
      <a href="{{ slug }}_{{ p }}.html"
         class="chip{% if p == profile %} chip--active{% endif %}"
         style="margin-top:0.5rem;display:inline-block;font-size:0.75rem">
        {% if p == profile %}Informe actual{% else %}Veure informe{% endif %}
      </a>
    </div>
    {% endif %}
    {% endfor %}
    <div class="cmp-card" style="background:var(--color-bg-alt)">
      <div class="cmp-card__label">Variació</div>
      <div class="cmp-card__score" style="color:#374151">{{ "%.1f"|format(comparative.score_variance) }}</div>
      <div class="cmp-card__profile">punts entre perfils</div>
      <a href="{{ slug }}_comparative.html"
         class="chip chip--cmp" style="margin-top:0.5rem;display:inline-block;font-size:0.75rem">
        Informe comparatiu
      </a>
    </div>
  </div>
  {% endif %}

</main>

{% include "footer.html.j2" %}

{# ── Scripts ──────────────────────────────────────────────────────────── #}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>

{# Dades injectades per Jinja2 (NO raw — Jinja2 ha de substituir les variables) #}
<script>
var RADAR_DATA   = {{ radar_json }};
var BAR_DATA     = {{ bar_json }};
</script>

{% raw %}
<script>
(function () {
  "use strict";

  /* ── Radar: Principis WCAG ─────────────────────────── */
  var radarCtx = document.getElementById("radar-canvas").getContext("2d");
  new Chart(radarCtx, {
    type: "radar",
    data: RADAR_DATA,
    options: {
      responsive: true,
      maintainAspectRatio: true,
      scales: {
        r: {
          min: 0, max: 100,
          ticks: {
            stepSize: 25,
            font: { size: 10 },
            color: "#6b7280",
            backdropColor: "transparent"
          },
          grid:        { color: "#e5e7eb" },
          angleLines:  { color: "#d1d5db" },
          pointLabels: { font: { size: 12, weight: "600" }, color: "#1f2937" }
        }
      },
      plugins: {
        legend: { position: "bottom", labels: { font: { size: 11 } } },
        tooltip: {
          callbacks: {
            label: function (ctx) {
              return ctx.dataset.label + ": " + ctx.parsed.r.toFixed(1) + "/100";
            }
          }
        }
      }
    }
  });

  /* ── Bar: 16 mètriques ─────────────────────────────── */
  var barCtx = document.getElementById("bar-canvas").getContext("2d");
  new Chart(barCtx, {
    type: "bar",
    data: BAR_DATA,
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        y: {
          min: 0, max: 100,
          ticks: { font: { size: 10 }, color: "#6b7280" },
          grid:  { color: "#f3f4f6" }
        },
        x: {
          ticks: { font: { size: 9 }, maxRotation: 50, color: "#6b7280" }
        }
      },
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: function (ctx) {
              return ctx.dataset.label + ": " + ctx.parsed.y.toFixed(1) + "/100";
            }
          }
        }
      }
    }
  });

  /* ── Export PNG ────────────────────────────────────── */
  window.exportChartPNG = function (canvasId, filename) {
    var canvas = document.getElementById(canvasId);
    var url    = canvas.toDataURL("image/png");
    var a      = document.createElement("a");
    a.href     = url;
    a.download = filename + ".png";
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  };
}());
</script>
{% endraw %}

</body>
</html>
