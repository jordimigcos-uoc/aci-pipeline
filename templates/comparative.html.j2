<!DOCTYPE html>
<html lang="ca">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Comparatiu de perfils · {{ domain }} — ACI Pipeline</title>
  <meta name="description" content="Informe comparatiu dels 3 perfils d'avaluació ACI per a {{ domain }}.">
  <link rel="stylesheet" href="../static/css/site.css">
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: var(--font-sans, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif); background: #f0f2f5; color: #1a1a2e; margin: 0; line-height: 1.55; }
    .visually-hidden { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
    .container { max-width: 1060px; margin: 0 auto; padding: 1.25rem 1rem 3rem; }

    /* Profile nav */
    .profile-nav { display:flex; gap:0.5rem; flex-wrap:wrap; align-items:center; padding:0.65rem 1.25rem; background:#fff; border-bottom:1px solid #e5e7eb; }
    .profile-chip { display:inline-flex; align-items:center; padding:0.28rem 0.85rem; border-radius:20px; font-size:0.78rem; font-weight:700; text-decoration:none; border:2px solid; transition:all 0.15s; opacity:0.65; }
    .profile-chip:hover { opacity:1; }
    .nav-sep { font-size:0.7rem; font-weight:700; color:#9ca3af; text-transform:uppercase; letter-spacing:0.06em; }
    .cmp-badge { margin-left:auto; display:inline-flex; align-items:center; padding:0.28rem 0.85rem; border-radius:20px; font-size:0.78rem; font-weight:700; background:#001f3f; color:#fff; }

    /* Hero */
    .hero { background:linear-gradient(135deg,#001f3f 0%,#003d7a 100%); color:#fff; border-radius:10px; padding:1.4rem 1.75rem; margin-bottom:1.25rem; }
    .hero h1 { margin:0 0 0.5rem; font-size:0.9rem; font-weight:700; opacity:0.7; text-transform:uppercase; letter-spacing:0.06em; }
    .hero p { margin:0.15rem 0; font-size:0.9rem; }
    .hero a { color:#93c5fd; }

    /* Profile cards */
    .profile-cards { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin-bottom:1.25rem; }
    @media (max-width:700px) { .profile-cards { grid-template-columns:1fr; } }
    .pc { border-radius:10px; padding:1.25rem; text-align:center; border:2px solid; box-shadow:0 2px 8px rgba(0,0,0,.07); }
    .pc h2 { margin:0 0 0.4rem; font-size:0.75rem; font-weight:800; text-transform:uppercase; letter-spacing:0.07em; }
    .pc .aci-v { font-size:2.75rem; font-weight:900; line-height:1; margin:0.2rem 0; }
    .pc .aci-m { font-size:0.78rem; opacity:0.65; }
    .pc .aci-q { display:inline-block; margin-top:0.35rem; font-size:0.8rem; font-weight:700; padding:0.15rem 0.7rem; border-radius:12px; }
    .pc .prof-link { display:inline-flex; align-items:center; margin-top:0.65rem; font-size:0.75rem; font-weight:700; text-decoration:none; padding:0.25rem 0.7rem; border-radius:12px; border:1.5px solid; }

    /* Cards */
    .card { background:#fff; border-radius:8px; box-shadow:0 1px 6px rgba(0,0,0,.06); margin-bottom:1rem; overflow:hidden; }
    .card-hd { padding:0.7rem 1.25rem; border-bottom:1px solid #f0f0f0; background:#fafafa; }
    .card-hd h2 { font-size:0.82rem; font-weight:800; color:#374151; margin:0; text-transform:uppercase; letter-spacing:0.05em; }
    .card-body { padding:1.25rem; }
    .charts-row { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
    @media (max-width:760px) { .charts-row { grid-template-columns:1fr; } }
    #radar-chart { display:flex; justify-content:center; }
    #bar-chart { overflow-x:auto; }

    /* Tables */
    .cmp-table { width:100%; border-collapse:collapse; font-size:0.82rem; }
    .cmp-table th { background:#f0f4f8; padding:0.5rem 0.75rem; text-align:left; font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; color:#555; white-space:nowrap; border-bottom:2px solid #e5e7eb; }
    .cmp-table td { padding:0.5rem 0.75rem; border-bottom:1px solid #f3f4f6; vertical-align:middle; }
    .cmp-table tr:last-child td { border-bottom:none; }
    .cmp-table td.num { text-align:right; font-weight:600; font-variant-numeric:tabular-nums; }
    .cmp-table tr:hover td { background:#f9fafb; }
    .best  { background:#dcfce7 !important; color:#15803d; }
    .worst { background:#fee2e2 !important; color:#dc2626; }
    code { background:#f1f3f5; padding:1px 5px; border-radius:3px; font-size:0.8em; font-family:Consolas,"Courier New",monospace; }

    /* Interventions grid */
    .interv-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; }
    @media (max-width:700px) { .interv-grid { grid-template-columns:1fr; } }
    .interv-col h3 { font-size:0.75rem; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; margin:0 0 0.5rem; }
    .interv-item { font-size:0.8rem; padding:0.4rem 0.65rem; border-radius:5px; margin-bottom:0.35rem; background:#f8f9fa; border-left:3px solid #dee2e6; line-height:1.4; }
    .interv-rank { font-weight:700; margin-right:0.3rem; }
    .interv-wcag { font-size:0.7rem; color:#9ca3af; margin-top:2px; }

    /* Legend */
    .legend { display:flex; gap:1rem; flex-wrap:wrap; font-size:0.78rem; color:#555; margin-top:0.5rem; }
    .legend-item { display:flex; align-items:center; gap:5px; }
    .legend-dot { width:12px; height:12px; border-radius:2px; }

    footer.site-footer { margin-top:2rem; }
  </style>
</head>
<body>
  <a class="skip-link" href="#main-content">Salta al contingut principal</a>

  <header class="site-header" role="banner">
    <a class="site-header__logo" href="../index.html" aria-label="ACI Pipeline — Inici">
      <span class="site-header__wordmark">ACI<br>Pipeline</span>
    </a>
    <nav class="site-header__nav" aria-label="Navegació principal">
      <ul role="list">
        <li><a href="../index.html">Índex global</a></li>
      </ul>
    </nav>
  </header>

  <!-- Perfil nav -->
  <nav class="profile-nav" aria-label="Navega als informes individuals per perfil">
    <span class="nav-sep">Perfils:</span>
    {% for p in profiles_list %}
    <a class="profile-chip"
       href="{{ slug }}_{{ p }}.html"
       style="color:{{ profile_colors[p] }};border-color:{{ profile_colors[p] }};background:{{ profile_bg[p] }}"
       aria-label="Veure informe perfil {{ profile_labels[p] }}">
      {{ profile_labels[p] }}
    </a>
    {% endfor %}
    <span class="cmp-badge">⇌ Comparatiu</span>
  </nav>

  <div class="container">
  <main id="main-content">

    <!-- Hero -->
    <div class="hero" role="region" aria-label="Informació de la URL analitzada">
      <h1>Informe comparatiu de perfils — ACI Pipeline</h1>
      <p><strong>URL:</strong> <a href="{{ clean_url }}" target="_blank" rel="noopener noreferrer">{{ clean_url }}</a></p>
      {% if category %}<p><strong>Categoria:</strong> {{ category }}</p>{% endif %}
      <p><strong>Data:</strong> {{ timestamp }} &nbsp;·&nbsp; <strong>Pipeline:</strong> v{{ pipeline_version }}</p>
    </div>

    <!-- Score cards per perfil -->
    <section aria-labelledby="scores-h">
      <h2 id="scores-h" class="visually-hidden">Puntuació ACI per perfil</h2>
      <div class="profile-cards">
        {% for p in profiles_list %}
        {% if p in profiles %}
        {% set pd = profiles[p] %}
        {% set s = pd.aci_score or 0 %}
        {% if s >= 3.5 %}{% set sc = "#27ae60" %}{% elif s >= 2.5 %}{% set sc = "#e67e22" %}{% else %}{% set sc = "#e74c3c" %}{% endif %}
        {% if s >= 4.0 %}{% set ql = "Excel·lent" %}{% elif s >= 3.0 %}{% set ql = "Bo" %}{% elif s >= 2.5 %}{% set ql = "Acceptable" %}{% else %}{% set ql = "Insuficient" %}{% endif %}
        <div class="pc" style="border-color:{{ profile_colors[p] }};background:{{ profile_bg[p] }}"
             role="group" aria-label="Perfil {{ profile_labels[p] }}: {{ s|round(2) }}/5.0">
          <h2 style="color:{{ profile_colors[p] }}">{{ profile_labels[p] }}</h2>
          <div class="aci-v" style="color:{{ sc }}">{{ s|round(2) }}</div>
          <div class="aci-m">/ 5.0</div>
          <div class="aci-q" style="background:{{ sc }}22;color:{{ sc }}">{{ ql }}</div>
          <div>
            <a class="prof-link" href="{{ slug }}_{{ p }}.html"
               style="color:{{ profile_colors[p] }};border-color:{{ profile_colors[p] }}"
               aria-label="Informe complet {{ profile_labels[p] }}">
              Veure informe →
            </a>
          </div>
        </div>
        {% endif %}
        {% endfor %}
      </div>
    </section>

    <!-- Gràfics D3: Radar + Grouped bar -->
    <div class="card" role="region" aria-labelledby="charts-h">
      <div class="card-hd"><h2 id="charts-h">Gràfics comparatius D3</h2></div>
      <div class="card-body">
        <div class="charts-row">
          <div>
            <p style="font-size:0.75rem;font-weight:700;color:#555;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:0.5rem">Radar · Sub-scores (0–5)</p>
            <div id="radar-chart" aria-label="Gràfic radar dels sub-scores per perfil"></div>
            <div class="legend">
              {% for p in profiles_list %}
              {% if p in profiles %}
              <div class="legend-item">
                <div class="legend-dot" style="background:{{ profile_colors[p] }}"></div>
                <span>{{ profile_labels[p] }}</span>
              </div>
              {% endif %}
              {% endfor %}
            </div>
          </div>
          <div>
            <p style="font-size:0.75rem;font-weight:700;color:#555;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:0.5rem">Barres agrupades · Mètriques normalitzades (0–1)</p>
            <div id="bar-chart" aria-label="Gràfic de barres agrupades de les 16 mètriques per perfil"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Taula de sub-scores -->
    <div class="card" role="region" aria-labelledby="subscores-h">
      <div class="card-hd"><h2 id="subscores-h">Comparativa de sub-scores</h2></div>
      <div style="overflow-x:auto">
        <table class="cmp-table" aria-label="Sub-scores per perfil">
          <thead>
            <tr>
              <th scope="col">Sub-score</th>
              {% for p in profiles_list %}{% if p in profiles %}
              <th scope="col">{{ profile_labels[p] }}</th>
              {% endif %}{% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for g in subgroups %}
            {% set vals = [] %}
            {% for p in profiles_list %}{% if p in profiles %}
              {% set v = profiles[p].sub_scores.get(g) %}
              {% if v is not none %}{% set _ = vals.append(v) %}{% endif %}
            {% endif %}{% endfor %}
            {% set bv = vals|max if vals else none %}
            {% set wv = vals|min if vals else none %}
            <tr>
              <th scope="row" style="text-transform:uppercase;letter-spacing:0.04em;font-size:0.8rem">{{ subgroup_labels[g] }}</th>
              {% for p in profiles_list %}{% if p in profiles %}
              {% set v = profiles[p].sub_scores.get(g) %}
              {% if v is not none %}
                {% if vals|length > 1 and v == bv %}<td class="num best">{{ v|round(2) }}</td>
                {% elif vals|length > 1 and v == wv %}<td class="num worst">{{ v|round(2) }}</td>
                {% else %}<td class="num">{{ v|round(2) }}</td>{% endif %}
              {% else %}<td class="num">—</td>{% endif %}
              {% endif %}{% endfor %}
            </tr>
            {% endfor %}
            <!-- ACI global -->
            {% set avals = [] %}
            {% for p in profiles_list %}{% if p in profiles %}{% set _ = avals.append(profiles[p].aci_score or 0) %}{% endif %}{% endfor %}
            <tr style="font-weight:800;border-top:2px solid #e5e7eb">
              <th scope="row" style="font-size:0.82rem">ACI GLOBAL</th>
              {% for p in profiles_list %}{% if p in profiles %}
              {% set v = profiles[p].aci_score or 0 %}
              {% if v == avals|max %}<td class="num best">{{ v|round(2) }}</td>
              {% elif v == avals|min %}<td class="num worst">{{ v|round(2) }}</td>
              {% else %}<td class="num">{{ v|round(2) }}</td>{% endif %}
              {% endif %}{% endfor %}
            </tr>
          </tbody>
        </table>
        <p style="font-size:0.73rem;color:#6b7280;padding:0.5rem 0.75rem">
          <span style="background:#dcfce7;padding:2px 6px;border-radius:3px;font-weight:700">millor</span> &nbsp;
          <span style="background:#fee2e2;padding:2px 6px;border-radius:3px;font-weight:700">pitjor</span>
        </p>
      </div>
    </div>

    <!-- Mètriques normalitzades comparatives -->
    <div class="card" role="region" aria-labelledby="metrics-h">
      <div class="card-hd"><h2 id="metrics-h">Mètriques normalitzades per perfil</h2></div>
      <div style="overflow-x:auto">
        <table class="cmp-table" aria-label="Les 16 mètriques normalitzades per perfil">
          <thead>
            <tr>
              <th scope="col">Mètrica</th>
              <th scope="col">Grup</th>
              {% for p in profiles_list %}{% if p in profiles %}
              <th scope="col">{{ profile_labels[p] }}</th>
              {% endif %}{% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for m in all_metrics %}
            {% set row_vals = [] %}
            {% for p in profiles_list %}{% if p in profiles %}
              {% set v = profiles[p].normalized_metrics.get(m) %}
              {% if v is not none %}{% set _ = row_vals.append(v) %}{% endif %}
            {% endif %}{% endfor %}
            {% set rbv = row_vals|max if row_vals else none %}
            {% set rwv = row_vals|min if row_vals else none %}
            <tr>
              <td><code>{{ m }}</code><div style="font-size:0.72rem;color:#9ca3af">{{ metric_labels[m] }}</div></td>
              <td><span style="font-size:0.7rem;color:#6b7280">{{ m | replace('_', ' ') | truncate(8, true, '') }}</span></td>
              {% for p in profiles_list %}{% if p in profiles %}
              {% set v = profiles[p].normalized_metrics.get(m) %}
              {% if v is not none %}
                {% if row_vals|length > 1 and v == rbv %}<td class="num best">{{ '%.3f'|format(v) }}</td>
                {% elif row_vals|length > 1 and v == rwv %}<td class="num worst">{{ '%.3f'|format(v) }}</td>
                {% else %}<td class="num">{{ '%.3f'|format(v) }}</td>{% endif %}
              {% else %}<td class="num">—</td>{% endif %}
              {% endif %}{% endfor %}
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Principals intervencions per perfil -->
    {% set has_interventions = profiles.values()|selectattr('interventions')|list|length > 0 %}
    {% if has_interventions %}
    <div class="card" role="region" aria-labelledby="interv-h">
      <div class="card-hd"><h2 id="interv-h">Principals intervencions per perfil (top 5)</h2></div>
      <div class="card-body">
        <div class="interv-grid">
          {% for p in profiles_list %}{% if p in profiles %}
          {% set pd = profiles[p] %}
          <div class="interv-col">
            <h3 style="color:{{ profile_colors[p] }}">{{ profile_labels[p] }}</h3>
            {% if pd.interventions %}
              {% for iv in pd.interventions[:5] %}
              <div class="interv-item" style="border-left-color:{{ profile_colors[p] }}">
                <span class="interv-rank">#{{ iv.priority_rank }}</span>{{ iv.action }}
                <div class="interv-wcag">{{ iv.metric }} · WCAG {{ iv.wcag_criterion }}</div>
              </div>
              {% endfor %}
            {% else %}
              <p style="font-size:0.78rem;color:#9ca3af">No disponible</p>
            {% endif %}
          </div>
          {% endif %}{% endfor %}
        </div>
      </div>
    </div>
    {% endif %}

  </main>
  </div>

  <footer class="site-footer" role="contentinfo">
    <p>ACI Pipeline v{{ pipeline_version }} · Jordi Miguel i Costal · TFM 2026 · UOC EEPSM</p>
    <p>WCAG 2.1/2.2 AA · EN 301 549 · axe-core · {{ timestamp }}</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js"></script>
  <script>
    var RADAR_DATA = {{ radar_data_json }};
    var BAR_DATA   = {{ bar_data_json }};
    var PROFILES_LIST = {{ profiles_list | tojson }};
    var PROFILE_COLORS = {
      wcag_strict: "{{ profile_colors.wcag_strict }}",
      readability_first: "{{ profile_colors.readability_first }}",
      visual_first: "{{ profile_colors.visual_first }}"
    };
    var PROFILE_LABELS = {
      wcag_strict: "WCAG Strict",
      readability_first: "Readability",
      visual_first: "Visual First"
    };
  </script>
  {% raw %}
  <script>
  /* ── Radar Chart ── */
  (function () {
    if (!window.d3 || !RADAR_DATA || !RADAR_DATA.length) return;
    var axes = ["wcag", "text", "elements", "performance"];
    var axisLabels = { wcag: "WCAG", text: "Text", elements: "Elements", performance: "Rend." };
    var N = axes.length;
    var angleSlice = Math.PI * 2 / N;
    var W = 340, H = 320, margin = 58;
    var radius = Math.min(W, H) / 2 - margin;

    var svg = d3.select("#radar-chart").append("svg")
      .attr("width", W).attr("height", H)
      .attr("viewBox", "0 0 " + W + " " + H)
      .attr("aria-hidden", "true")
      .append("g").attr("transform", "translate(" + W / 2 + "," + H / 2 + ")");

    var rSc = d3.scaleLinear().domain([0, 5]).range([0, radius]);

    // Concentric grid circles + labels
    [1, 2, 3, 4, 5].forEach(function (lvl) {
      svg.append("circle").attr("r", rSc(lvl))
        .attr("fill", "none").attr("stroke", "#e5e7eb")
        .attr("stroke-width", lvl === 5 ? 1.5 : 0.8);
      svg.append("text").attr("x", 3).attr("y", -rSc(lvl) + 4)
        .attr("font-size", "9px").attr("fill", "#9ca3af").text(lvl);
    });

    // Axis lines + labels
    axes.forEach(function (axis, i) {
      var angle = angleSlice * i - Math.PI / 2;
      var x = rSc(5) * Math.cos(angle), y = rSc(5) * Math.sin(angle);
      svg.append("line").attr("x1", 0).attr("y1", 0).attr("x2", x).attr("y2", y)
        .attr("stroke", "#d1d5db").attr("stroke-width", 1);
      var lx = (radius + 22) * Math.cos(angle), ly = (radius + 22) * Math.sin(angle);
      svg.append("text").attr("x", lx).attr("y", ly)
        .attr("text-anchor", "middle").attr("dominant-baseline", "central")
        .attr("font-size", "11px").attr("font-weight", "700").attr("fill", "#374151")
        .text(axisLabels[axis]);
    });

    // Profile polygons
    var lineGen = d3.line().x(function (d) { return d[0]; }).y(function (d) { return d[1]; })
      .curve(d3.curveLinearClosed);

    RADAR_DATA.forEach(function (prof) {
      var pts = axes.map(function (axis, i) {
        var angle = angleSlice * i - Math.PI / 2;
        var r = rSc(prof[axis] || 0);
        return [r * Math.cos(angle), r * Math.sin(angle)];
      });
      svg.append("path").datum(pts).attr("d", lineGen)
        .attr("fill", prof.color).attr("fill-opacity", 0.12)
        .attr("stroke", prof.color).attr("stroke-width", 2.5);
      pts.forEach(function (pt) {
        svg.append("circle").attr("cx", pt[0]).attr("cy", pt[1]).attr("r", 4)
          .attr("fill", prof.color).attr("stroke", "#fff").attr("stroke-width", 1.5);
      });
    });
  }());

  /* ── Grouped Bar Chart ── */
  (function () {
    if (!window.d3 || !BAR_DATA || !BAR_DATA.length) return;
    var SHORT = {
      color_contrast_ratio: "Contrast", focus_visible_ratio: "Focus",
      target_size_clean: "Mida", keyboard_clean: "Teclat",
      aria_roles_valid: "ARIA", accessible_names_coverage: "Noms",
      audit_critical_violations: "Crít.", audit_high_violations: "Alt",
      audit_medium_violations: "Mod.", audit_low_violations: "Baix",
      page_flesch: "Flesch", text_complexity: "Compl.",
      heading_hierarchy: "Jerarq.", alt_text_coverage: "AltTx",
      landmark_coverage: "Land.", performance_lcp: "LCP"
    };
    var profiles = ["wcag_strict", "readability_first", "visual_first"];
    var m = { top: 18, right: 10, bottom: 90, left: 18 };
    var el = document.getElementById("bar-chart");
    if (!el) return;
    var fullW = el.clientWidth || 460;
    var W = fullW - m.left - m.right, H = 220;

    var svg = d3.select("#bar-chart").append("svg")
      .attr("width", fullW).attr("height", H + m.top + m.bottom)
      .attr("aria-hidden", "true")
      .append("g").attr("transform", "translate(" + m.left + "," + m.top + ")");

    var x0 = d3.scaleBand().domain(BAR_DATA.map(function (d) { return d.metric; }))
      .range([0, W]).padding(0.18);
    var x1 = d3.scaleBand().domain(profiles).range([0, x0.bandwidth()]).padding(0.04);
    var y = d3.scaleLinear().domain([0, 1]).range([H, 0]);

    // Y grid + axis
    svg.append("g").call(d3.axisLeft(y).ticks(4).tickSize(-W).tickFormat(d3.format(".1f")))
      .call(function (g) {
        g.select(".domain").remove();
        g.selectAll(".tick line").attr("stroke", "#f0f0f0");
        g.selectAll("text").attr("font-size", "9px").attr("fill", "#9ca3af");
      });

    // X axis
    svg.append("g").attr("transform", "translate(0," + H + ")")
      .call(d3.axisBottom(x0).tickSize(0)
        .tickFormat(function (k) { return SHORT[k] || k; }))
      .call(function (g) {
        g.select(".domain").remove();
        g.selectAll("text").attr("transform", "rotate(-55)")
          .style("text-anchor", "end").attr("font-size", "9px").attr("fill", "#6b7280");
      });

    // Grouped bars
    BAR_DATA.forEach(function (d) {
      profiles.forEach(function (p) {
        svg.append("rect")
          .attr("x", x0(d.metric) + x1(p))
          .attr("y", y(d[p] || 0))
          .attr("width", x1.bandwidth())
          .attr("height", H - y(d[p] || 0))
          .attr("fill", PROFILE_COLORS[p] || "#888")
          .attr("fill-opacity", 0.8).attr("rx", 2);
      });
    });
  }());
  </script>
  {% endraw %}
</body>
</html>
